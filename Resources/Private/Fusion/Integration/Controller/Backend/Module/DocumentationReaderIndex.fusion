// NOT RELEVANT 9.0 migration: Line 11: You very likely need to rewrite "VARIABLE.label" to "Neos.Node.label(VARIABLE)". We did not auto-apply this migration because we cannot be sure whether the variable is a Node.
UpAssist.DocumentationReader.Backend.Module.DocumentationReaderController.index = Neos.Fusion:Component {
  endpoints = ${Configuration.setting('UpAssist.DocumentationReader.documentationEndpoints')}
  documentationUrl = ${Configuration.setting('UpAssist.DocumentationReader.documentationUrl')}
  renderer = afx`
    <iframe src={props.documentationUrl} width="100%" height="100%" @if={!props.endpoints && props.documentationUrl}></iframe>
    <Neos.Fusion:Fragment @if={props.endpoints}>
      <div class="tab-wrap">
        <Neos.Fusion:Loop items={props.endpoints} itemName="endpoint">
          <Neos.Fusion:Fragment @context.isMarkdown={String.endsWith(String.toLowerCase(Array.first(String.split(Array.first(String.split(endpoint.url, '?')), '#'))), '.md')}>
            <input type="radio" id={'tab' + iterator.index} name="tabs" class="tab" checked="checked" checked.@if={iterator.isFirst} />
            <label for={'tab' + iterator.index}>{endpoint.label} <a href={endpoint.url} target="_blank" title="Open in a new window" @if={!isMarkdown}><i class="fas fa-external-link-alt"></i></a></label>
          </Neos.Fusion:Fragment>
        </Neos.Fusion:Loop>
        <Neos.Fusion:Loop items={props.endpoints} itemName="endpoint">
          <div id={'tab-content' + iterator.index} class="tab__content" @context.isMarkdown={String.endsWith(String.toLowerCase(Array.first(String.split(Array.first(String.split(endpoint.url, '?')), '#'))), '.md')}>
            <iframe src={endpoint.url} width="100%" height="100%" @if={!isMarkdown}></iframe>
            <div class="markdown local-markdown" @if={isMarkdown}>
              {Markdown.parse(endpoint.url)}
            </div>
          </div>
        </Neos.Fusion:Loop>
      </div>
    </Neos.Fusion:Fragment>
  `
}
